{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*supervisectl*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/supervisectl",
            "args": ["hook", "pre-tool-use"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^supervise:code-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/supervisectl",
            "args": ["hook", "subagent-start"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/supervisectl",
            "args": ["hook", "subagent-stop"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
